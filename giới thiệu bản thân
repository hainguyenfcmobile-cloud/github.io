<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>ĐỊT MẸ MÀY</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&display=swap">
<style>
/* Layout: floating glass nav pill; asymmetric hero (big name left, quick-profile glass card right);
   glass panels scroll over a fixed backdrop of morphing colour blobs and crisp orbs that the glass blurs. */
:root{
  --bg:#dbe7ef;
  --fg:#0f1d29;
  --muted:#3c5163;
  --accent:#e4492a;
  --btn-bg:#c2381b;
  --btn-fg:#ffffff;
  --ok:#1f9d55;
  --glow:255,128,92;

  --blob-a:#ff8a63; --blob-b:#25d3c2; --blob-c:#6c97ff; --blob-o:.8;
  --orb-o:.95;

  --glass-top:rgba(255,255,255,.55);
  --glass-bottom:rgba(255,255,255,.2);
  --glass-solid:rgba(240,246,250,.94);
  --edge:rgba(255,255,255,.7);
  --rim-a:rgba(255,255,255,.95);
  --rim-b:rgba(255,255,255,.55);
  --inner:rgba(255,255,255,.7);
  --shadow:rgba(28,60,84,.22);
  --chip:rgba(255,255,255,.36);
  --chip-hover:rgba(255,255,255,.66);
  --line:rgba(15,29,41,.14);

  --font-display:"Bricolage Grotesque","Be Vietnam Pro",system-ui,sans-serif;
  --font-body:"Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#061218;
    --fg:#e9f3f7;
    --muted:#9bb2c0;
    --accent:#ff8d68;
    --btn-bg:#ff946f;
    --btn-fg:#1d0c06;
    --ok:#4ade80;
    --blob-o:.55;
    --orb-o:.85;
    --glass-top:rgba(255,255,255,.15);
    --glass-bottom:rgba(255,255,255,.04);
    --glass-solid:rgba(20,32,42,.94);
    --edge:rgba(255,255,255,.2);
    --rim-a:rgba(255,255,255,.55);
    --rim-b:rgba(255,255,255,.22);
    --inner:rgba(255,255,255,.3);
    --shadow:rgba(0,0,0,.5);
    --chip:rgba(255,255,255,.1);
    --chip-hover:rgba(255,255,255,.2);
    --line:rgba(255,255,255,.14);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#061218;
  --fg:#e9f3f7;
  --muted:#9bb2c0;
  --accent:#ff8d68;
  --btn-bg:#ff946f;
  --btn-fg:#1d0c06;
  --ok:#4ade80;
  --blob-o:.55;
  --orb-o:.85;
  --glass-top:rgba(255,255,255,.15);
  --glass-bottom:rgba(255,255,255,.04);
  --glass-solid:rgba(20,32,42,.94);
  --edge:rgba(255,255,255,.2);
  --rim-a:rgba(255,255,255,.55);
  --rim-b:rgba(255,255,255,.22);
  --inner:rgba(255,255,255,.3);
  --shadow:rgba(0,0,0,.5);
  --chip:rgba(255,255,255,.1);
  --chip-hover:rgba(255,255,255,.2);
  --line:rgba(255,255,255,.14);
  color-scheme:dark;
}

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--bg);
  color:var(--fg);
  font:400 1rem/1.65 var(--font-body);
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,p,dl,dd,ul{margin:0}
a{color:inherit}
a:focus-visible,.chip:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

/* ---------- backdrop ---------- */
.stage{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:0}
.blob{
  position:absolute;width:58vmax;height:58vmax;
  border-radius:46% 54% 58% 42% / 48% 42% 58% 52%;
  filter:blur(70px);opacity:var(--blob-o);
  animation:morph 26s ease-in-out infinite alternate;
}
.blob.a{background:var(--blob-a);top:-20vmax;left:-16vmax}
.blob.b{background:var(--blob-b);right:-18vmax;top:20vh;animation-duration:32s;animation-delay:-8s}
.blob.c{background:var(--blob-c);left:8vw;bottom:-28vmax;animation-duration:38s;animation-delay:-15s}
@keyframes morph{
  0%{transform:translate3d(0,0,0) rotate(0deg) scale(1);border-radius:46% 54% 58% 42% / 48% 42% 58% 52%}
  100%{transform:translate3d(6vmax,4vmax,0) rotate(40deg) scale(1.12);border-radius:58% 42% 40% 60% / 56% 60% 40% 44%}
}
.orb{
  position:absolute;border-radius:50%;opacity:var(--orb-o);
  background:radial-gradient(circle at 30% 26%,#fff 0,var(--o1) 30%,var(--o2) 100%);
  box-shadow:inset 0 -8px 20px rgba(0,0,0,.18);
  animation:float 15s ease-in-out infinite alternate;
}
.orb.o1{--o1:#ffb08f;--o2:#f0532f;width:150px;height:150px;top:13%;right:11%}
.orb.o2{--o1:#8ff3e6;--o2:#0fa597;width:88px;height:88px;left:7%;top:46%;animation-duration:19s;animation-delay:-5s}
.orb.o3{--o1:#b3c8ff;--o2:#4a72ee;width:190px;height:190px;left:48%;bottom:5%;animation-duration:23s;animation-delay:-9s}
@keyframes float{
  0%{transform:translate3d(0,0,0)}
  100%{transform:translate3d(-26px,34px,0)}
}

/* ---------- liquid glass ---------- */
.glass{
  position:relative;
  isolation:isolate;
  border:1px solid var(--edge);
  border-radius:var(--r,28px);
  background:linear-gradient(135deg,var(--glass-top),var(--glass-bottom));
  -webkit-backdrop-filter:blur(22px) saturate(1.8);
  backdrop-filter:blur(22px) saturate(1.8);
  box-shadow:
    inset 0 1px 1px var(--inner),
    inset 0 -1px 1px rgba(255,255,255,.12),
    inset 0 0 26px rgba(255,255,255,.07),
    0 14px 44px var(--shadow);
}
.glass>*{position:relative;z-index:1}
/* edge light: bright at top-left and bottom-right, like a bevelled pane */
.glass::after{
  content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;
  background:linear-gradient(155deg,var(--rim-a),rgba(255,255,255,0) 36%,rgba(255,255,255,0) 64%,var(--rim-b));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;
  mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0);
  mask-composite:exclude;
  opacity:.8;
}
/* specular highlight that follows the cursor */
.glass::before{
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:radial-gradient(260px circle at var(--mx,50%) var(--my,0%),rgba(255,255,255,.38),rgba(255,255,255,0) 62%);
  opacity:0;transition:opacity .35s;
}
@media (hover:hover){.glass:hover::before{opacity:1}}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  .glass{background:var(--glass-solid)}
}

/* ---------- layout ---------- */
.page{
  position:relative;z-index:1;
  max-width:1120px;margin-inline:auto;
  padding-inline:clamp(16px,4vw,32px);
  padding-block:0 40px;
}
section{padding-block:clamp(32px,6vw,64px);scroll-margin-top:84px}
h2{font:700 clamp(1.8rem,4.5vw,2.8rem)/1.1 var(--font-display);letter-spacing:-.025em;text-wrap:balance}
.sec-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 18px;margin-bottom:22px}
.sec-head p{color:var(--muted);max-width:44ch}

/* nav */
.nav{
  position:sticky;top:calc(env(safe-area-inset-top,0px) + 12px);z-index:20;
  --r:999px;
  display:flex;align-items:center;justify-content:space-between;gap:8px;
  margin-top:12px;padding:7px 7px 7px 22px;
}
.brand{font:700 1.05rem var(--font-display);letter-spacing:-.01em;text-decoration:none}
.nav ul{display:flex;gap:2px;padding:0;list-style:none}
.nav ul a{
  display:block;padding:8px 15px;border-radius:999px;
  color:var(--muted);text-decoration:none;font-size:.9rem;font-weight:500;
  transition:background .25s,color .25s,transform .35s cubic-bezier(.3,1.6,.5,1);
}
.nav ul a[aria-current="true"]{background:var(--chip-hover);color:var(--fg)}
@media (hover:hover){.nav ul a:hover{background:var(--chip-hover);color:var(--fg);transform:translateY(-2px) scale(1.05)}}

/* hero */
.hero{
  display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.8fr);
  gap:clamp(24px,5vw,56px);align-items:center;
  padding-block:clamp(40px,8vw,92px) clamp(24px,5vw,56px);
}
.hero>*{min-width:0}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-weight:500;font-size:.92rem;color:var(--muted);letter-spacing:.02em}
.eyebrow::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 5px rgba(var(--glow),.25)}
.name{font:800 clamp(3.4rem,11vw,7.5rem)/.95 var(--font-display);letter-spacing:-.035em;margin-block:.12em .22em}
.word{display:inline-block;white-space:nowrap}
.ch{display:inline-block;transition:transform .22s ease-out}
.sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;user-select:none;-webkit-user-select:none}
.lead{font-size:1.125rem;color:var(--muted);max-width:44ch}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}

.btn{
  position:relative;display:inline-flex;align-items:center;gap:10px;
  padding:14px 24px;border-radius:999px;overflow:hidden;
  font:600 .95rem var(--font-body);text-decoration:none;
  transition:transform .4s cubic-bezier(.3,1.5,.5,1),box-shadow .3s;
}
.btn .arr{display:inline-block;transition:transform .35s cubic-bezier(.3,1.6,.5,1)}
.btn:active{transform:scale(.97)}
.btn-primary{
  background:linear-gradient(180deg,rgba(255,255,255,.3),rgba(255,255,255,0) 55%),var(--btn-bg);
  color:var(--btn-fg);
  box-shadow:inset 0 1px 1px rgba(255,255,255,.6),0 10px 28px rgba(var(--glow),.38);
}
.btn-primary::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);
  transform:translateX(-130%);transition:transform .75s;
}
.btn.glass{--r:999px;color:var(--fg)}
@media (hover:hover){
  .btn:hover{transform:translateY(-3px) scale(1.04)}
  .btn:hover .arr{transform:translateX(5px)}
  .btn-primary:hover{box-shadow:inset 0 1px 1px rgba(255,255,255,.6),0 16px 36px rgba(var(--glow),.5)}
  .btn-primary:hover::after{transform:translateX(130%)}
}

/* tilt cards (set by script: --rx, --ry) */
.tilt{
  transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(var(--ty,0px));
  transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s;
}
@media (hover:hover){.tilt:hover{--ty:-7px;box-shadow:inset 0 1px 1px var(--inner),inset 0 0 26px rgba(255,255,255,.1),0 26px 60px var(--shadow)}}

/* hero profile card */
.profile{padding:28px;display:grid;gap:20px;justify-items:start}
.avatar{
  width:116px;height:116px;display:grid;place-items:center;
  font:800 2.5rem var(--font-display);letter-spacing:-.02em;color:#10202c;
  border-radius:58% 42% 55% 45% / 48% 56% 44% 52%;
  background:
    radial-gradient(circle at 30% 24%,rgba(255,255,255,.9) 0,rgba(255,255,255,0) 34%),
    linear-gradient(145deg,#ff9873,#25d3c2);
  box-shadow:inset 0 -12px 26px rgba(0,0,0,.18),inset 0 4px 10px rgba(255,255,255,.6),0 16px 34px rgba(var(--glow),.32);
  animation:liquid 10s ease-in-out infinite;
  transition:transform .6s cubic-bezier(.3,1.6,.5,1);
}
@keyframes liquid{
  0%,100%{border-radius:58% 42% 55% 45% / 48% 56% 44% 52%}
  33%{border-radius:44% 56% 42% 58% / 56% 44% 58% 42%}
  66%{border-radius:52% 48% 60% 40% / 42% 58% 42% 58%}
}
@media (hover:hover){.profile:hover .avatar{transform:scale(1.09) rotate(-7deg)}}
.status{display:inline-flex;align-items:center;gap:9px;padding:6px 13px;border-radius:999px;background:var(--chip);border:1px solid var(--edge);font-size:.84rem;font-weight:500}
.status::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--ok);animation:pulse 2.4s ease-out infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(31,157,85,.55)}80%,100%{box-shadow:0 0 0 9px rgba(31,157,85,0)}}
.facts{width:100%}
.facts div{display:grid;grid-template-columns:6.5em minmax(0,1fr);gap:12px;padding:12px 0;border-top:1px solid var(--line)}
.facts dt{color:var(--muted);font-size:.86rem}
.facts dd{font-weight:500}

/* about */
.about{
  padding:clamp(24px,4vw,44px);
  display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(24px,4vw,48px);
}
.about .text{display:grid;gap:16px;align-content:start}
.about .text p{max-width:60ch}

/* contact */
.contact{padding:clamp(24px,5vw,56px);display:grid;gap:26px}
.contact .intro{display:grid;gap:10px;max-width:52ch}
.contact .intro p{color:var(--muted)}
.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:16px}
.link{
  --r:24px;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:22px 24px;text-decoration:none;color:var(--fg);
  transition:transform .4s cubic-bezier(.3,1.5,.5,1),box-shadow .35s;
}
.link .label{display:grid;gap:2px;min-width:0}
.link strong{font:700 1.6rem/1.1 var(--font-display);letter-spacing:-.02em}
.link small{color:var(--muted);font-size:.9rem}
.link .go{
  flex:none;width:44px;height:44px;display:grid;place-items:center;border-radius:50%;
  background:var(--chip);border:1px solid var(--edge);
  transition:transform .45s cubic-bezier(.3,1.6,.5,1),background .25s,color .25s;
}
@media (hover:hover){
  .link:hover{transform:translateY(-5px) scale(1.02);box-shadow:inset 0 1px 1px var(--inner),0 24px 54px var(--shadow)}
  .link:hover .go{transform:rotate(45deg) scale(1.12);background:var(--btn-bg);color:var(--btn-fg)}
}

footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 16px;padding-top:24px;color:var(--muted);font-size:.88rem}

/* page-load rise (transform only, always visible) */
.rise{animation:rise .85s cubic-bezier(.2,.8,.2,1) var(--d,0s) backwards}
@keyframes rise{from{transform:translateY(16px)}}

/* cursor glow */
.cursor-glow{
  position:fixed;left:-65px;top:-65px;width:130px;height:130px;border-radius:50%;
  pointer-events:none;z-index:50;opacity:0;scale:1;
  background:radial-gradient(circle,rgba(var(--glow),.5) 0,rgba(var(--glow),.2) 38%,rgba(var(--glow),0) 70%);
  transition:opacity .3s,scale .4s cubic-bezier(.3,1.4,.5,1);
  will-change:transform;
}
.cursor-glow.on{opacity:1}
.cursor-glow.big{scale:1.7}
@media (hover:none),(pointer:coarse){.cursor-glow{display:none}}

/* responsive */
@media (max-width:820px){
  .hero,.about{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:560px){
  .nav{padding:6px 6px 6px 16px}
  .nav ul a{padding:8px 12px;font-size:.85rem}
  .blob{filter:blur(48px)}
  .orb.o1{width:110px;height:110px}
  .orb.o3{width:130px;height:130px}
  .facts div{grid-template-columns:5.5em minmax(0,1fr)}
}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition-duration:.01ms!important}
  .cursor-glow{display:none}
}
</style>
</head>
<body>

<div class="stage" aria-hidden="true">
  <div class="blob a"></div><div class="blob b"></div><div class="blob c"></div>
  <div class="orb o1"></div><div class="orb o2"></div><div class="orb o3"></div>
</div>
<div class="cursor-glow" aria-hidden="true"></div>

<div class="page" id="top">
  <header class="nav glass">
    <a class="brand" href="#top">Hải</a>
    <nav aria-label="Điều hướng">
      <ul>
        <li><a href="#about">Giới thiệu</a></li>
        <li><a href="#contact">Liên hệ</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <div class="hero">
      <div>
        <p class="eyebrow rise" data-shift>Xin chào, mình là</p>
        <h1 class="name rise" style="--d:.08s" data-shift>Hải</h1>
        <p class="lead rise" style="--d:.16s" data-shift>Tao là 1 học sinh ở trường THCS Xuy Xá cơ sơ Xuy Xá.</p>
        <div class="cta rise" style="--d:.24s">
          <a class="btn btn-primary" href="#about">Đọc giới thiệu <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn glass" href="#contact">Nhắn rep chuỗi cho tao (nếu rảnh nhá con chó)</a>
        </div>
      </div>

      <aside class="profile glass tilt rise" style="--d:.2s" aria-label="Hồ sơ nhanh">
        <div class="avatar" aria-hidden="true">ĐMM</div>
        <dl class="facts">
        </dl>
      </aside>
    </div>

    <section id="about">
      <div class="sec-head"><h2 data-shift>Về tao</h2></div>
      <div class="about glass">
        <div class="text">
          <p data-shift>Tao là 1 học sinh ở trường THCS Xuy Xá cơ sơ Xuy Xá.</p>
          <p data-shift>Ngoài giờ học, tao chơi Delta Force, Liên quân, Valorant.</p>
        </div>
        <dl class="facts">
        </dl>
      </div>
    </section>

    <section id="contact">
      <div class="contact glass">
        <div class="intro">
          <h2 data-shift>Liên hệ tại:</h2>
        </div>
        <div class="links">
          <!-- Thay href bằng liên kết trang cá nhân của bạn -->
          <a class="link glass" href="https://www.facebook.com/hai.nguyen.405658/" target="_blank" rel="noopener noreferrer">
            <span class="label"><strong data-shift>Facebook</strong><small data-shift>Nhắn tin lừa đảo tại đây</small></span>
            <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
          </a>
          <a class="link glass" href="https://www.tiktok.com/@thanglondaden1" target="_blank" rel="noopener noreferrer">
            <span class="label"><strong data-shift>TikTok</strong><small data-shift>Không có video đâu</small></span>
            <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <span>© Claude</span>
    <span>Trang viết bằng Claude AI nên đừng nghĩ tao tài</span>
  </footer>
</div>

<script>
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var R = 110, R2 = R * R;

  // ---- Chữ dịch ra xa nhẹ nhàng khi chuột lại gần ----
  var chars = [];
  var mx = -9999, my = -9999, active = false, frameId = 0;

  function split(el) {
    var txt = el.textContent.trim().normalize('NFC');
    var size = parseFloat(window.getComputedStyle(el).fontSize) || 16;
    var amp = Math.min(18, Math.max(4, size * 0.35));
    el.textContent = '';
    var sr = document.createElement('span');
    sr.className = 'sr';
    sr.textContent = txt;
    el.appendChild(sr);
    var wrap = document.createElement('span');
    wrap.setAttribute('aria-hidden', 'true');
    txt.split(/\s+/).forEach(function (w, i, arr) {
      var word = document.createElement('span');
      word.className = 'word';
      Array.from(w).forEach(function (c) {
        var s = document.createElement('span');
        s.className = 'ch';
        s.textContent = c;
        word.appendChild(s);
        chars.push({ el: s, amp: amp, cx: 0, cy: 0, tx: 0, ty: 0 });
      });
      wrap.appendChild(word);
      if (i < arr.length - 1) wrap.appendChild(document.createTextNode(' '));
    });
    el.appendChild(wrap);
  }

  function measure() {
    var sx = window.scrollX, sy = window.scrollY;
    chars.forEach(function (c) { c.el.style.transition = 'none'; c.el.style.transform = 'none'; });
    chars.forEach(function (c) {
      var r = c.el.getBoundingClientRect();
      c.cx = r.left + r.width / 2 + sx;
      c.cy = r.top + r.height / 2 + sy;
      c.tx = 0; c.ty = 0;
    });
    chars.forEach(function (c) { c.el.style.transition = ''; c.el.style.transform = ''; });
    schedule();
  }

  function frame() {
    frameId = 0;
    var sx = window.scrollX, sy = window.scrollY;
    for (var i = 0; i < chars.length; i++) {
      var c = chars[i], tx = 0, ty = 0;
      if (active) {
        var dx = c.cx - sx - mx, dy = c.cy - sy - my;
        if (dx > -R && dx < R && dy > -R && dy < R) {
          var d2 = dx * dx + dy * dy;
          if (d2 < R2) {
            var d = Math.sqrt(d2) || 1;
            var k = 1 - d / R;
            var f = k * k * c.amp;
            tx = Math.round(dx / d * f * 10) / 10;
            ty = Math.round(dy / d * f * 10) / 10;
          }
        }
      }
      if (tx !== c.tx || ty !== c.ty) {
        c.tx = tx; c.ty = ty;
        c.el.style.transform = (tx || ty) ? 'translate3d(' + tx + 'px,' + ty + 'px,0)' : '';
      }
    }
  }
  function schedule() { if (!frameId) frameId = requestAnimationFrame(frame); }

  if (fine && !reduce) {
    document.querySelectorAll('[data-shift]').forEach(split);
    var timer = 0;
    var remeasure = function () { clearTimeout(timer); timer = setTimeout(measure, 120); };
    measure();
    window.addEventListener('resize', remeasure);
    window.addEventListener('load', measure);
    window.addEventListener('scroll', schedule, { passive: true });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    setTimeout(measure, 1300);
    if ('ResizeObserver' in window) new ResizeObserver(remeasure).observe(document.body);
  }

  // ---- Hào quang nhỏ quanh con trỏ ----
  var glow = document.querySelector('.cursor-glow');
  var tx = 0, ty = 0, x = 0, y = 0, shown = false, raf = 0;
  function tick() {
    x += (tx - x) * 0.22;
    y += (ty - y) * 0.22;
    glow.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
    raf = (Math.abs(tx - x) > 0.1 || Math.abs(ty - y) > 0.1) ? requestAnimationFrame(tick) : 0;
  }

  document.addEventListener('pointermove', function (e) {
    if (e.pointerType === 'touch') return;
    var t = e.target;

    mx = e.clientX; my = e.clientY; active = true;
    if (chars.length) schedule();

    if (glow && fine && !reduce) {
      tx = e.clientX; ty = e.clientY;
      if (!shown) { shown = true; x = tx; y = ty; glow.classList.add('on'); }
      glow.classList.toggle('big', !!(t.closest && t.closest('a,.glass')));
      if (!raf) raf = requestAnimationFrame(tick);
    }

    // Ánh sáng phản chiếu trên kính + nghiêng nhẹ thẻ
    var g = t.closest ? t.closest('.glass') : null;
    if (!g) return;
    var r = g.getBoundingClientRect();
    g.style.setProperty('--mx', (e.clientX - r.left) + 'px');
    g.style.setProperty('--my', (e.clientY - r.top) + 'px');
    if (!reduce && g.classList.contains('tilt')) {
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      g.style.setProperty('--ry', (px * 9).toFixed(2) + 'deg');
      g.style.setProperty('--rx', (-py * 9).toFixed(2) + 'deg');
    }
  }, { passive: true });

  document.addEventListener('pointerout', function (e) {
    var g = e.target.closest ? e.target.closest('.tilt') : null;
    if (g && !g.contains(e.relatedTarget)) {
      g.style.setProperty('--rx', '0deg');
      g.style.setProperty('--ry', '0deg');
    }
  });
  document.addEventListener('mouseleave', function () {
    active = false;
    if (chars.length) schedule();
    if (glow) { glow.classList.remove('on'); shown = false; }
  });

  // ---- Đánh dấu mục đang xem trên thanh điều hướng ----
  var links = Array.prototype.slice.call(document.querySelectorAll('.nav ul a'));
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        links.forEach(function (a) { a.removeAttribute('aria-current'); });
        var a = document.querySelector('.nav ul a[href="#' + en.target.id + '"]');
        if (a) a.setAttribute('aria-current', 'true');
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    ['about', 'contact'].forEach(function (id) {
      var sec = document.getElementById(id);
      if (sec) io.observe(sec);
    });
  }
})();
</script>

</body>
</html>
